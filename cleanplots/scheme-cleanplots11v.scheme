*! cleanplots11v v1.1.0 Trenton Mize 2026-10-12
*! Ordinal companion scheme to cleanplots: 11 sequential viridis colors
*
* Inherits the primary cleanplots scheme via #include. Overrides colors
* in Stata's 15 plot slots, while retaining independent line patterns
* and marker symbols. Ordered categories run from light yellow to dark purple.
*
* Color source: viridis (van der Walt & Smith 2015), sampled at end=.95 and direction=-1.
* Matching R scale:
*   scale_color_viridis_d(option = "viridis", end = 0.95, direction = -1)
*
* Colors recycle after 11 series when there are more than 11 plots.
* The 15 plot styles retain their own line patterns and marker symbols.
* Bar/area fills inherit cleanplots' 70 percent intensity.
*
* Example: graph bar price, over(rep78) asyvars scheme(cleanplots11v)

#include cleanplots

color p1              "222 227 24"
color p1line          "222 227 24"
color p1lineplot      "222 227 24"
color p1markline      "222 227 24"
color p1bar           "222 227 24"
color p1barline       "222 227 24"
color p1area          "222 227 24"
color p1arealine      "222 227 24"
color p1pie           "222 227 24"
linepattern p1line solid
linepattern p1lineplot solid
symbol p1 smcircle

color p2              "157 217 59"
color p2line          "157 217 59"
color p2lineplot      "157 217 59"
color p2markline      "157 217 59"
color p2bar           "157 217 59"
color p2barline       "157 217 59"
color p2area          "157 217 59"
color p2arealine      "157 217 59"
color p2pie           "157 217 59"
linepattern p2line dash
linepattern p2lineplot dash
symbol p2 smsquare

color p3              "98 203 95"
color p3line          "98 203 95"
color p3lineplot      "98 203 95"
color p3markline      "98 203 95"
color p3bar           "98 203 95"
color p3barline       "98 203 95"
color p3area          "98 203 95"
color p3arealine      "98 203 95"
color p3pie           "98 203 95"
linepattern p3line shortdash
linepattern p3lineplot shortdash
symbol p3 smtriangle

color p4              "53 182 121"
color p4line          "53 182 121"
color p4lineplot      "53 182 121"
color p4markline      "53 182 121"
color p4bar           "53 182 121"
color p4barline       "53 182 121"
color p4area          "53 182 121"
color p4arealine      "53 182 121"
color p4pie           "53 182 121"
linepattern p4line longdash
linepattern p4lineplot longdash
symbol p4 smdiamond

color p5              "31 161 136"
color p5line          "31 161 136"
color p5lineplot      "31 161 136"
color p5markline      "31 161 136"
color p5bar           "31 161 136"
color p5barline       "31 161 136"
color p5area          "31 161 136"
color p5arealine      "31 161 136"
color p5pie           "31 161 136"
linepattern p5line dash_dot
linepattern p5lineplot dash_dot
symbol p5 plus

