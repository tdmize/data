color p2line          "72 38 119"
color p2lineplot      "72 38 119"
color p2markline      "72 38 119"
color p2bar           "72 38 119"
color p2barline       "72 38 119"
color p2area          "72 38 119"
color p2arealine      "72 38 119"
color p2pie           "72 38 119"
