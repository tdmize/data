*! cleanplots3v v1.1.0 Trenton Mize 2026-10-12
*! Ordinal companion scheme to cleanplots: 3 sequential viridis colors
*
* Inherits the primary cleanplots scheme via #include. Overrides colors
* in Stata's 15 plot slots, while retaining independent line patterns
* and marker symbols. Ordered categories run from light yellow to dark purple.
*
* Color source: viridis (van der Walt & Smith 2015), sampled at end=.95 and direction=-1.
* Matching R scale:
*   scale_color_viridis_d(option = "viridis", end = 0.95, direction = -1)
*
* Colors recycle after 3 series when there are more than 3 plots.
* The 15 plot styles retain their own line patterns and marker symbols.
* Bar/area fills inherit cleanplots' 70 percent intensity.
*
* Example: graph bar price, over(rep78) asyvars scheme(cleanplots3v)

#include cleanplots

color p1              "222 227 24"
color p1line          "222 227 24"
color p1lineplot      "222 227 24"
color p1markline      "222 227 24"
color p1bar           "222 227 24"
color p1barline       "222 227 24"
color p1area          "222 227 24"
color p1arealine      "222 227 24"
color p1pie           "222 227 24"
linepattern p1line solid
linepattern p1lineplot solid
symbol p1 smcircle

color p2              "35 138 141"
color p2line          "35 138 141"
color p2lineplot      "35 138 141"
color p2markline      "35 138 141"
color p2bar           "35 138 141"
color p2barline       "35 138 141"
color p2area          "35 138 141"
color p2arealine      "35 138 141"
color p2pie           "35 138 141"
linepattern p2line dash
linepattern p2lineplot dash
symbol p2 smsquare

color p3              "68 1 84"
color p3line          "68 1 84"
color p3lineplot      "68 1 84"
color p3markline      "68 1 84"
color p3bar           "68 1 84"
color p3barline       "68 1 84"
color p3area          "68 1 84"
color p3arealine      "68 1 84"
color p3pie           "68 1 84"
linepattern p3line shortdash
linepattern p3lineplot shortdash
symbol p3 smtriangle

color p4              "222 227 24"
color p4line          "222 227 24"
color p4lineplot      "222 227 24"
color p4markline      "222 227 24"
color p4bar           "222 227 24"
color p4barline       "222 227 24"
color p4area          "222 227 24"
color p4arealine      "222 227 24"
color p4pie           "222 227 24"
linepattern p4line longdash
linepattern p4lineplot longdash
symbol p4 smdiamond

color p5              "35 138 141"
color p5line          "35 138 141"
color p5lineplot      "35 138 141"
color p5markline      "35 138 141"
color p5bar           "35 138 141"
color p5barline       "35 138 141"
color p5area          "35 138 141"
color p5arealine      "35 138 141"
color p5pie           "35 138 141"
linepattern p5line dash_dot
linepattern p5lineplot dash_dot
symbol p5 plus

