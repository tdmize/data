color p3line          "40 64 108"
color p3lineplot      "40 64 108"
color p3markline      "40 64 108"
color p3bar           "40 64 108"
color p3barline       "40 64 108"
color p3area          "40 64 108"
color p3arealine      "40 64 108"
color p3pie           "40 64 108"
linepattern p3line shortdash
linepattern p3lineplot shortdash
symbol p3 smtriangle

