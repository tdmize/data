color p4line          "91 200 100"
color p4lineplot      "91 200 100"
color p4markline      "91 200 100"
color p4bar           "91 200 100"
color p4barline       "91 200 100"
color p4area          "91 200 100"
color p4arealine      "91 200 100"
color p4pie           "91 200 100"
linepattern p4line longdash
linepattern p4lineplot longdash
symbol p4 smdiamond

