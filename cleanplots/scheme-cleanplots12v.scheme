color p5lineplot      "35 169 131"
color p5markline      "35 169 131"
color p5bar           "35 169 131"
color p5barline       "35 169 131"
color p5area          "35 169 131"
color p5arealine      "35 169 131"
color p5pie           "35 169 131"
linepattern p5line dash_dot
linepattern p5lineplot dash_dot
symbol p5 plus

