*! cleanplots6v v1.1.0 Trenton Mize 2026-10-12
*! Ordinal companion scheme to cleanplots: 6 sequential viridis colors
*
* Inherits the primary cleanplots scheme via #include. Overrides colors
* in Stata's 15 plot slots, while retaining independent line patterns
* and marker symbols. Ordered categories run from light yellow to dark purple.
*
* Color source: viridis (van der Walt & Smith 2015), sampled at end=.95 and direction=-1.
* Matching R scale:
*   scale_color_viridis_d(option = "viridis", end = 0.95, direction = -1)
*
* Colors recycle after 6 series when there are more than 6 plots.
* The 15 plot styles retain their own line patterns and marker symbols.
* Bar/area fills inherit cleanplots' 70 percent intensity.
*
* Example: graph bar price, over(rep78) asyvars scheme(cleanplots6v)

#include cleanplots

color p1              "222 227 24"
color p1line          "222 227 24"
color p1lineplot      "222 227 24"
color p1markline      "222 227 24"
color p1bar           "222 227 24"
color p1barline       "222 227 24"
color p1area          "222 227 24"
color p1arealine      "222 227 24"
color p1pie           "222 227 24"
linepattern p1line solid
linepattern p1lineplot solid
symbol p1 smcircle

color p2              "98 203 95"
color p2line          "98 203 95"
color p2lineplot      "98 203 95"
color p2markline      "98 203 95"
color p2bar           "98 203 95"
color p2barline       "98 203 95"
color p2area          "98 203 95"
color p2arealine      "98 203 95"
color p2pie           "98 203 95"
linepattern p2line dash
linepattern p2lineplot dash
symbol p2 smsquare

color p3              "31 161 136"
color p3line          "31 161 136"
color p3lineplot      "31 161 136"
color p3markline      "31 161 136"
color p3bar           "31 161 136"
color p3barline       "31 161 136"
color p3area          "31 161 136"
color p3arealine      "31 161 136"
color p3pie           "31 161 136"
linepattern p3line shortdash
linepattern p3lineplot shortdash
symbol p3 smtriangle

color p4              "44 115 142"
color p4line          "44 115 142"
color p4lineplot      "44 115 142"
color p4markline      "44 115 142"
color p4bar           "44 115 142"
color p4barline       "44 115 142"
color p4area          "44 115 142"
color p4arealine      "44 115 142"
color p4pie           "44 115 142"
linepattern p4line longdash
linepattern p4lineplot longdash
symbol p4 smdiamond

color p5              "66 64 134"
color p5line          "66 64 134"
color p5lineplot      "66 64 134"
color p5markline      "66 64 134"
color p5bar           "66 64 134"
color p5barline       "66 64 134"
color p5area          "66 64 134"
color p5arealine      "66 64 134"
color p5pie           "66 64 134"
linepattern p5line dash_dot
linepattern p5lineplot dash_dot
symbol p5 plus

color p6              "68 1 84"
color p6line          "68 1 84"
color p6lineplot      "68 1 84"
color p6markline      "68 1 84"
color p6bar           "68 1 84"
color p6barline       "68 1 84"
color p6area          "68 1 84"
color p6arealine      "68 1 84"
color p6pie           "68 1 84"
linepattern p6line shortdash_dot
linepattern p6lineplot shortdash_dot
symbol p6 x

color p7              "222 227 24"
color p7line          "222 227 24"
color p7lineplot      "222 227 24"
color p7markline      "222 227 24"
color p7bar           "222 227 24"
color p7barline       "222 227 24"
color p7area          "222 227 24"
color p7arealine      "222 227 24"
color p7pie           "222 227 24"
linepattern p7line longdash_dot
linepattern p7lineplot longdash_dot
symbol p7 smcircle_hollow

