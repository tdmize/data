*! cleanplots10 v1.1.0 Trenton Mize 2026-10-12
*! Ordinal companion scheme to cleanplots: 10 sequential cividis colors
*
* Inherits the primary cleanplots scheme via #include. Overrides colors
* in Stata's 15 plot slots, while retaining independent line patterns
* and marker symbols. Ordered categories run from light yellow to dark navy.
*
* Color source: cividis (Nunez, Anderton, & Renslow 2018), sampled at end=.95 and direction=-1.
* Matching R scale:
*   scale_color_viridis_d(option = "cividis", end = 0.95, direction = -1)
*
* Colors recycle after 10 series when there are more than 10 plots.
* The 15 plot styles retain their own line patterns and marker symbols.
* Bar/area fills inherit cleanplots' 70 percent intensity.
*
* Example: graph bar price, over(rep78) asyvars scheme(cleanplots10)

#include cleanplots

color p1              "246 221 77"
color p1line          "246 221 77"
color p1lineplot      "246 221 77"
color p1markline      "246 221 77"
color p1bar           "246 221 77"
color p1barline       "246 221 77"
color p1area          "246 221 77"
color p1arealine      "246 221 77"
color p1pie           "246 221 77"
linepattern p1line solid
linepattern p1lineplot solid
symbol p1 smcircle

color p2              "215 196 99"
color p2line          "215 196 99"
color p2lineplot      "215 196 99"
color p2markline      "215 196 99"
color p2bar           "215 196 99"
color p2barline       "215 196 99"
color p2area          "215 196 99"
color p2arealine      "215 196 99"
color p2pie           "215 196 99"
linepattern p2line dash
linepattern p2lineplot dash
symbol p2 smsquare

color p3              "185 172 112"
color p3line          "185 172 112"
color p3lineplot      "185 172 112"
color p3markline      "185 172 112"
color p3bar           "185 172 112"
color p3barline       "185 172 112"
color p3area          "185 172 112"
color p3arealine      "185 172 112"
color p3pie           "185 172 112"
linepattern p3line shortdash
linepattern p3lineplot shortdash
symbol p3 smtriangle

color p4              "158 150 119"
color p4line          "158 150 119"
color p4lineplot      "158 150 119"
color p4markline      "158 150 119"
color p4bar           "158 150 119"
color p4barline       "158 150 119"
color p4area          "158 150 119"
color p4arealine      "158 150 119"
color p4pie           "158 150 119"
linepattern p4line longdash
linepattern p4lineplot longdash
symbol p4 smdiamond

color p5              "132 129 121"
color p5line          "132 129 121"
color p5lineplot      "132 129 121"
color p5markline      "132 129 121"
color p5bar           "132 129 121"
color p5barline       "132 129 121"
color p5area          "132 129 121"
color p5arealine      "132 129 121"
color p5pie           "132 129 121"
linepattern p5line dash_dot
linepattern p5lineplot dash_dot
symbol p5 plus

