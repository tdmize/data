color p6line          "108 110 114"
color p6lineplot      "108 110 114"
color p6markline      "108 110 114"
color p6bar           "108 110 114"
color p6barline       "108 110 114"
color p6area          "108 110 114"
color p6arealine      "108 110 114"
color p6pie           "108 110 114"
linepattern p6line shortdash_dot
linepattern p6lineplot shortdash_dot
symbol p6 x

