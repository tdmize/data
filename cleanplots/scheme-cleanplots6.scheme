*! cleanplots6 v1.1.0 Trenton Mize 2026-10-12
*! Ordinal companion scheme to cleanplots: 6 sequential cividis colors
*
* Inherits the primary cleanplots scheme via #include. Overrides colors
* in Stata's 15 plot slots, while retaining independent line patterns
* and marker symbols. Ordered categories run from light yellow to dark navy.
*
* Color source: cividis (Nunez, Anderton, & Renslow 2018), sampled at end=.95 and direction=-1.
* Matching R scale:
*   scale_color_viridis_d(option = "cividis", end = 0.95, direction = -1)
*
* Colors recycle after 6 series when there are more than 6 plots.
* The 15 plot styles retain their own line patterns and marker symbols.
* Bar/area fills inherit cleanplots' 70 percent intensity.
*
* Example: graph bar price, over(rep78) asyvars scheme(cleanplots6)

#include cleanplots

color p1              "246 221 77"
color p1line          "246 221 77"
color p1lineplot      "246 221 77"
color p1markline      "246 221 77"
color p1bar           "246 221 77"
color p1barline       "246 221 77"
color p1area          "246 221 77"
color p1arealine      "246 221 77"
color p1pie           "246 221 77"
linepattern p1line solid
linepattern p1lineplot solid
symbol p1 smcircle

color p2              "192 177 110"
color p2line          "192 177 110"
color p2lineplot      "192 177 110"
color p2markline      "192 177 110"
color p2bar           "192 177 110"
color p2barline       "192 177 110"
color p2area          "192 177 110"
color p2arealine      "192 177 110"
color p2pie           "192 177 110"
linepattern p2line dash
linepattern p2lineplot dash
symbol p2 smsquare

color p3              "141 137 121"
color p3line          "141 137 121"
color p3lineplot      "141 137 121"
color p3markline      "141 137 121"
color p3bar           "141 137 121"
color p3barline       "141 137 121"
color p3area          "141 137 121"
color p3arealine      "141 137 121"
color p3pie           "141 137 121"
linepattern p3line shortdash
linepattern p3lineplot shortdash
symbol p3 smtriangle

color p4              "99 102 111"
color p4line          "99 102 111"
color p4lineplot      "99 102 111"
color p4markline      "99 102 111"
color p4bar           "99 102 111"
color p4barline       "99 102 111"
color p4area          "99 102 111"
color p4arealine      "99 102 111"
color p4pie           "99 102 111"
linepattern p4line longdash
linepattern p4lineplot longdash
symbol p4 smdiamond

color p5              "47 67 108"
color p5line          "47 67 108"
color p5lineplot      "47 67 108"
color p5markline      "47 67 108"
color p5bar           "47 67 108"
color p5barline       "47 67 108"
color p5area          "47 67 108"
color p5arealine      "47 67 108"
color p5pie           "47 67 108"
linepattern p5line dash_dot
linepattern p5lineplot dash_dot
symbol p5 plus

