color p5line          "50 182 122"
color p5lineplot      "50 182 122"
color p5markline      "50 182 122"
color p5bar           "50 182 122"
color p5barline       "50 182 122"
color p5area          "50 182 122"
color p5arealine      "50 182 122"
color p5pie           "50 182 122"
linepattern p5line dash_dot
linepattern p5lineplot dash_dot
symbol p5 plus

