color p7line          "110 111 115"
color p7lineplot      "110 111 115"
color p7markline      "110 111 115"
color p7bar           "110 111 115"
color p7barline       "110 111 115"
color p7area          "110 111 115"
color p7arealine      "110 111 115"
color p7pie           "110 111 115"
linepattern p7line longdash_dot
linepattern p7lineplot longdash_dot
symbol p7 smcircle_hollow

