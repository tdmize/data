*! cleanplots12 v1.1.0 Trenton Mize 2026-10-12
*! Ordinal companion scheme to cleanplots: 12 sequential cividis colors
*
* Inherits the primary cleanplots scheme via #include. Overrides colors
* in Stata's 15 plot slots, while retaining independent line patterns
* and marker symbols. Ordered categories run from light yellow to dark navy.
*
* Color source: cividis (Nunez, Anderton, & Renslow 2018), sampled at end=.95 and direction=-1.
* Matching R scale:
*   scale_color_viridis_d(option = "cividis", end = 0.95, direction = -1)
*
* Colors recycle after 12 series when there are more than 12 plots.
* The 15 plot styles retain their own line patterns and marker symbols.
* Bar/area fills inherit cleanplots' 70 percent intensity.
*
* Example: graph bar price, over(rep78) asyvars scheme(cleanplots12)

#include cleanplots

color p1              "246 221 77"
color p1line          "246 221 77"
color p1lineplot      "246 221 77"
color p1markline      "246 221 77"
color p1bar           "246 221 77"
color p1barline       "246 221 77"
color p1area          "246 221 77"
color p1arealine      "246 221 77"
color p1pie           "246 221 77"
linepattern p1line solid
linepattern p1lineplot solid
symbol p1 smcircle

color p2              "220 200 96"
color p2line          "220 200 96"
color p2lineplot      "220 200 96"
color p2markline      "220 200 96"
color p2bar           "220 200 96"
color p2barline       "220 200 96"
color p2area          "220 200 96"
color p2arealine      "220 200 96"
color p2pie           "220 200 96"
linepattern p2line dash
linepattern p2lineplot dash
symbol p2 smsquare

color p3              "196 181 108"
color p3line          "196 181 108"
color p3lineplot      "196 181 108"
color p3markline      "196 181 108"
color p3bar           "196 181 108"
color p3barline       "196 181 108"
color p3area          "196 181 108"
color p3arealine      "196 181 108"
color p3pie           "196 181 108"
linepattern p3line shortdash
linepattern p3lineplot shortdash
symbol p3 smtriangle

color p4              "173 162 116"
color p4line          "173 162 116"
color p4lineplot      "173 162 116"
color p4markline      "173 162 116"
color p4bar           "173 162 116"
color p4barline       "173 162 116"
color p4area          "173 162 116"
color p4arealine      "173 162 116"
color p4pie           "173 162 116"
linepattern p4line longdash
linepattern p4lineplot longdash
symbol p4 smdiamond

color p5              "150 144 120"
color p5line          "150 144 120"
color p5lineplot      "150 144 120"
color p5markline      "150 144 120"
color p5bar           "150 144 120"
color p5barline       "150 144 120"
color p5area          "150 144 120"
color p5arealine      "150 144 120"
color p5pie           "150 144 120"
linepattern p5line dash_dot
linepattern p5lineplot dash_dot
symbol p5 plus

color p6              "130 128 121"
color p6line          "130 128 121"
color p6lineplot      "130 128 121"
color p6markline      "130 128 121"
color p6bar           "130 128 121"
color p6barline       "130 128 121"
color p6area          "130 128 121"
color p6arealine      "130 128 121"
color p6pie           "130 128 121"
linepattern p6line shortdash_dot
linepattern p6lineplot shortdash_dot
symbol p6 x

