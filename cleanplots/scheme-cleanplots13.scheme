color p5line          "158 150 119"
color p5lineplot      "158 150 119"
color p5markline      "158 150 119"
color p5bar           "158 150 119"
color p5barline       "158 150 119"
color p5area          "158 150 119"
color p5arealine      "158 150 119"
color p5pie           "158 150 119"
linepattern p5line dash_dot
linepattern p5lineplot dash_dot
symbol p5 plus

