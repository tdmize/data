color p6lineplot      "137 134 121"
color p6markline      "137 134 121"
color p6bar           "137 134 121"
color p6barline       "137 134 121"
color p6area          "137 134 121"
color p6arealine      "137 134 121"
color p6pie           "137 134 121"
