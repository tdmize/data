color p5lineplot      "41 175 127"
color p5markline      "41 175 127"
color p5bar           "41 175 127"
color p5barline       "41 175 127"
color p5area          "41 175 127"
color p5arealine      "41 175 127"
color p5pie           "41 175 127"
