color p6line          "69 55 129"
color p6lineplot      "69 55 129"
color p6markline      "69 55 129"
color p6bar           "69 55 129"
color p6barline       "69 55 129"
color p6area          "69 55 129"
color p6arealine      "69 55 129"
color p6pie           "69 55 129"
linepattern p6line shortdash_dot
linepattern p6lineplot shortdash_dot
symbol p6 x

color p7              "68 1 84"
color p7line          "68 1 84"
color p7lineplot      "68 1 84"
color p7markline      "68 1 84"
color p7bar           "68 1 84"
color p7barline       "68 1 84"
color p7area          "68 1 84"
color p7arealine      "68 1 84"
color p7pie           "68 1 84"
linepattern p7line longdash_dot
linepattern p7lineplot longdash_dot
symbol p7 smcircle_hollow

