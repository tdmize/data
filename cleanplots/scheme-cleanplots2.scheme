color p5line          "246 221 77"
color p5lineplot      "246 221 77"
color p5markline      "246 221 77"
color p5bar           "246 221 77"
color p5barline       "246 221 77"
color p5area          "246 221 77"
color p5arealine      "246 221 77"
color p5pie           "246 221 77"
linepattern p5line dash_dot
linepattern p5lineplot dash_dot
symbol p5 plus

