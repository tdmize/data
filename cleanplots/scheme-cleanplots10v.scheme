*! cleanplots10v v1.1.0 Trenton Mize 2026-10-12
*! Ordinal companion scheme to cleanplots: 10 sequential viridis colors
*
* Inherits the primary cleanplots scheme via #include. Overrides colors
* in Stata's 15 plot slots, while retaining independent line patterns
* and marker symbols. Ordered categories run from light yellow to dark purple.
*
* Color source: viridis (van der Walt & Smith 2015), sampled at end=.95 and direction=-1.
* Matching R scale:
*   scale_color_viridis_d(option = "viridis", end = 0.95, direction = -1)
*
* Colors recycle after 10 series when there are more than 10 plots.
* The 15 plot styles retain their own line patterns and marker symbols.
* Bar/area fills inherit cleanplots' 70 percent intensity.
*
* Example: graph bar price, over(rep78) asyvars scheme(cleanplots10v)

#include cleanplots

color p1              "222 227 24"
color p1line          "222 227 24"
color p1lineplot      "222 227 24"
color p1markline      "222 227 24"
color p1bar           "222 227 24"
color p1barline       "222 227 24"
color p1area          "222 227 24"
color p1arealine      "222 227 24"
color p1pie           "222 227 24"
linepattern p1line solid
linepattern p1lineplot solid
symbol p1 smcircle

color p2              "150 216 63"
color p2line          "150 216 63"
color p2lineplot      "150 216 63"
color p2markline      "150 216 63"
color p2bar           "150 216 63"
color p2barline       "150 216 63"
color p2area          "150 216 63"
color p2arealine      "150 216 63"
color p2pie           "150 216 63"
linepattern p2line dash
linepattern p2lineplot dash
symbol p2 smsquare

color p3              "87 198 102"
color p3line          "87 198 102"
color p3lineplot      "87 198 102"
color p3markline      "87 198 102"
color p3bar           "87 198 102"
color p3barline       "87 198 102"
color p3area          "87 198 102"
color p3arealine      "87 198 102"
color p3pie           "87 198 102"
linepattern p3line shortdash
linepattern p3lineplot shortdash
symbol p3 smtriangle

color p4              "41 175 127"
color p4line          "41 175 127"
color p4lineplot      "41 175 127"
color p4markline      "41 175 127"
color p4bar           "41 175 127"
color p4barline       "41 175 127"
color p4area          "41 175 127"
color p4arealine      "41 175 127"
color p4pie           "41 175 127"
linepattern p4line longdash
linepattern p4lineplot longdash
symbol p4 smdiamond

color p5              "31 151 139"
color p5line          "31 151 139"
color p5lineplot      "31 151 139"
color p5markline      "31 151 139"
color p5bar           "31 151 139"
color p5barline       "31 151 139"
color p5area          "31 151 139"
color p5arealine      "31 151 139"
color p5pie           "31 151 139"
linepattern p5line dash_dot
linepattern p5lineplot dash_dot
symbol p5 plus

color p6              "39 126 142"
color p6line          "39 126 142"
color p6lineplot      "39 126 142"
color p6markline      "39 126 142"
color p6bar           "39 126 142"
color p6barline       "39 126 142"
color p6area          "39 126 142"
color p6arealine      "39 126 142"
color p6pie           "39 126 142"
linepattern p6line shortdash_dot
linepattern p6lineplot shortdash_dot
symbol p6 x

color p7              "50 100 142"
color p7line          "50 100 142"
color p7lineplot      "50 100 142"
color p7markline      "50 100 142"
color p7bar           "50 100 142"
color p7barline       "50 100 142"
color p7area          "50 100 142"
color p7arealine      "50 100 142"
color p7pie           "50 100 142"
linepattern p7line longdash_dot
linepattern p7lineplot longdash_dot
symbol p7 smcircle_hollow

color p8              "63 71 136"
color p8line          "63 71 136"
color p8lineplot      "63 71 136"
color p8markline      "63 71 136"
color p8bar           "63 71 136"
color p8barline       "63 71 136"
color p8area          "63 71 136"
color p8arealine      "63 71 136"
color p8pie           "63 71 136"
