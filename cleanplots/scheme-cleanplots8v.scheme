color p5lineplot      "41 122 142"
color p5markline      "41 122 142"
color p5bar           "41 122 142"
color p5barline       "41 122 142"
color p5area          "41 122 142"
color p5arealine      "41 122 142"
color p5pie           "41 122 142"
linepattern p5line dash_dot
linepattern p5lineplot dash_dot
symbol p5 plus

