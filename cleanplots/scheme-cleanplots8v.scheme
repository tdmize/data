*! cleanplots8v v1.1.0 Trenton Mize 2026-10-12
*! Ordinal companion scheme to cleanplots: 8 sequential viridis colors
*
* Inherits the primary cleanplots scheme via #include. Overrides colors
* in Stata's 15 plot slots, while retaining independent line patterns
* and marker symbols. Ordered categories run from light yellow to dark purple.
*
* Color source: viridis (van der Walt & Smith 2015), sampled at end=.95 and direction=-1.
* Matching R scale:
*   scale_color_viridis_d(option = "viridis", end = 0.95, direction = -1)
*
* Colors recycle after 8 series when there are more than 8 plots.
* The 15 plot styles retain their own line patterns and marker symbols.
* Bar/area fills inherit cleanplots' 70 percent intensity.
*
* Example: graph bar price, over(rep78) asyvars scheme(cleanplots8v)

#include cleanplots

color p1              "222 227 24"
color p1line          "222 227 24"
color p1lineplot      "222 227 24"
color p1markline      "222 227 24"
color p1bar           "222 227 24"
color p1barline       "222 227 24"
color p1area          "222 227 24"
color p1arealine      "222 227 24"
color p1pie           "222 227 24"
linepattern p1line solid
linepattern p1lineplot solid
symbol p1 smcircle

color p2              "131 212 76"
color p2line          "131 212 76"
color p2lineplot      "131 212 76"
color p2markline      "131 212 76"
color p2bar           "131 212 76"
color p2barline       "131 212 76"
color p2area          "131 212 76"
color p2arealine      "131 212 76"
color p2pie           "131 212 76"
linepattern p2line dash
linepattern p2lineplot dash
symbol p2 smsquare

color p3              "58 186 118"
color p3line          "58 186 118"
color p3lineplot      "58 186 118"
color p3markline      "58 186 118"
color p3bar           "58 186 118"
color p3barline       "58 186 118"
color p3area          "58 186 118"
color p3arealine      "58 186 118"
color p3pie           "58 186 118"
linepattern p3line shortdash
linepattern p3lineplot shortdash
symbol p3 smtriangle

color p4              "31 154 138"
color p4line          "31 154 138"
color p4lineplot      "31 154 138"
color p4markline      "31 154 138"
color p4bar           "31 154 138"
color p4barline       "31 154 138"
color p4area          "31 154 138"
color p4arealine      "31 154 138"
color p4pie           "31 154 138"
linepattern p4line longdash
linepattern p4lineplot longdash
symbol p4 smdiamond

